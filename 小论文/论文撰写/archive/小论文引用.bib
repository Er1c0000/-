@article{nannuru_sparse_2019,
	title = {Sparse {Bayesian} learning with multiple dictionaries},
	volume = {159},
	issn = {0165-1684},
	url = {https://www.sciencedirect.com/science/article/pii/S0165168419300520},
	doi = {10.1016/j.sigpro.2019.02.003},
	abstract = {Sparse Bayesian learning (SBL) has emerged as a fast and competitive method to perform sparse processing. The SBL algorithm, which is developed using a Bayesian framework, iteratively solves a non-convex optimization problem using fixed point updates. It provides comparable performance and is significantly faster than convex optimization techniques used in sparse processing. We propose a multi-dictionary SBL algorithm that simultaneously can process observations generated by different underlying dictionaries sharing the same sparsity profile. Two algorithms are proposed and corresponding fixed point update equations are derived. Noise variances are estimated using stochastic maximum likelihood. The multi-dictionary SBL has many practical applications. We demonstrate this using direction-of-arrival (DOA) estimation. The first example uses the proposed multi-dictionary SBL to process multi-frequency observations. We show how spatial aliasing can be avoided while processing multi-frequency observations using SBL. SWellEx-96 experimental data demonstrates qualitatively these advantages. In the second example we show how data corrupted with heteroscedastic noise can be processed using multi-dictionary SBL with data pre-whitening.},
	language = {en-US},
	urldate = {2026-03-26},
	journal = {Signal Processing},
	author = {Nannuru, Santosh and Gemba, Kay L. and Gerstoft, Peter and Hodgkiss, William S. and Mecklenbräuker, Christoph F.},
	month = jun,
	year = {2019},
	keywords = {Aliasing, Beamforming, Compressive sensing, DOA estimation, Heteroscedastic noise, Multi frequency, Multiple dictionaries, Sparse Bayesian learning, Wide band},
	pages = {159--170},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\14030\\Zotero\\storage\\4GAMCI3E\\Nannuru 等 - 2019 - Sparse Bayesian learning with multiple dictionaries.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\14030\\Zotero\\storage\\FCDQZUYI\\S0165168419300520.html:text/html},
}

@inproceedings{chen_neural_2024,
	title = {Neural {Network}-{Based} {Compensation} of {Time} {Base} {Jitter} in {High}-{Speed} {Equivalent} {Sampling} {Oscilloscopes}},
	url = {https://ieeexplore.ieee.org/abstract/document/10959397},
	doi = {10.1109/ICVISP64524.2024.10959397},
	abstract = {The sampling clock of the equivalent sampling oscilloscope is typically not provided directly; rather, the clock signal of the same frequency and phase must be recovered from the data signal. In the process of sampling and reconstructing high-frequency signals, multiple modules are passed through, all of which may introduce the time base jitter during signal processing. Therefore, it is necessary to reduce its impact by technical means and accurately estimating and compensating for this error is a challenging task. Recently, Bilal Moussa implemented time-based correction by employing a sampling technique through two reference channels that exhibited one phase difference of about 90 degrees, thereby reducing jitter to a level of around 260 fs. Concurrently, Jiangmiao Zhu enhanced this orthogonal distance regression algorithm through the adoption of an innovative weight distribution approach, which was subsequently utilized for the estimation of time jitter in sampling oscilloscopes. However, the time base jitter can be even smaller. To rectify the time base discrepancies in wideband sampling oscilloscope readings, an optimized back propagation (BP) neural network, enhanced by the sparrow search algorithm, is utilized for the analysis and compensation of oscilloscope's sampled signals. After simulation verification, the neural network showed a reduction in jitter to 221 fs.},
	urldate = {2026-03-26},
	booktitle = {2024 {IEEE} 8th {International} {Conference} on {Vision}, {Image} and {Signal} {Processing} ({ICVISP})},
	author = {Chen, Ming and Fang, Shuo and Xu, Zhengshan and Pan, Dafa and Gao, Ziang and Zhao, Tonggang},
	month = dec,
	year = {2024},
	keywords = {Backpropagation, BP neural network, Clocks, Estimation, Jitter, Neural networks, Oscilloscopes, Prediction algorithms, sampling oscilloscope, Signal processing, Signal processing algorithms, sparrow search algorithm, time base jitter, Wideband},
	pages = {1--5},
}

