@inproceedings{peng_jitter_2025,
	title = {Jitter {Decomposition} {Based} on {Dual}-{Dirac} {Model}: {A} {Two}-{Stage} {Limited}-{Sampling} {Algorithm}},
	issn = {2994-5100},
	shorttitle = {Jitter {Decomposition} {Based} on {Dual}-{Dirac} {Model}},
	url = {https://ieeexplore.ieee.org/abstract/document/11306605},
	doi = {10.1109/ICEMI66537.2025.11306605},
	abstract = {With the increasing demand for timing accuracy in electronic systems, jitter control has emerged as a critical challenge in high-speed digital communications. To effectively suppress jitter, decomposition methods based on equivalent- time sampling oscilloscopes are employed to identify its sources. However, jitter decomposition often requires extensive sampling points, leading to prolonged measurement times that fail to meet the stringent real-time requirements of online testing and adaptive clock recovery. To address this challenge, this paper proposes a two-stage jitter decomposition algorithm based on dual-Dirac model, which decomposes deterministic jitter and random jitter. The proposed method employs a two- stage decomposition process: (1) an initial coarse estimation using maximum a posteriori-based gradient descent, followed by (2) Markov chain Monte Carlo-based parameter refinement. Experimental results demonstrate superior performance, with Kullback-Leibler divergence reduced to 0.0356 at 64 sampling point, provides a 17.21º/o improvement in accuracy compared to Gaussian mixture model and a 63.19º/o enhancement over kernel density estimation, while the relative bias of parameter significantly outperforming baseline schemes across different number of samples.},
	language = {en-US},
	urldate = {2026-03-05},
	booktitle = {2025 {IEEE} 17th {International} {Conference} on {Electronic} {Measurement} \& {Instruments} ({ICEMI})},
	author = {Peng, Jing and Li, Zihao and Sun, Qihang and Qi, Zhihui and Pan, Data and Zhao, Tonggang},
	month = aug,
	year = {2025},
	note = {ISSN: 2994-5100},
	keywords = {Accuracy, double-dirac model, Estimation, Jitter, jitter decomposition, Markov chain Monte Carlo, maximum a posteriori, Monte Carlo methods, Optimization, Oscilloscopes, Prevention and mitigation, Real-time systems, Testing, Timing},
	pages = {169--174},
	file = {PDF:C\:\\Users\\14030\\Zotero\\storage\\87TM76IG\\Peng 等 - 2025 - Jitter Decomposition Based on Dual-Dirac Model A Two-Stage Limited-Sampling Algorithm.pdf:application/pdf;Snapshot:C\:\\Users\\14030\\Zotero\\storage\\XRSDFQVC\\11306605.html:text/html},
}

@inproceedings{wu_jitter_2025,
	title = {Jitter {Decomposition} for {High}-{Speed} {Serial} {Signals} {Based} on {Convolutional} {Neural} {Network}},
	issn = {2994-5100},
	url = {https://ieeexplore.ieee.org/abstract/document/11306444},
	doi = {10.1109/ICEMI66537.2025.11306444},
	abstract = {In high-precision digital signal analysis, jitter decomposition is crucial for signal integrity evaluation. Traditional jitter decomposition methods, including dual-Dirac model, exhibit limitations in analyzing deterministic jitter (DJ) and random jitter (RJ) in high-speed signals, making it difficult to accurately separate complex jitter components including duty cycle distortion (DCD), which causes unequal durations of the effective high and low signal levels and will lead to bit errors in high-speed signals. This paper proposes a CNN-based jitter decomposition method for automatic classification and prediction of RJ, DJ and DCD and validates the effectiveness of jitter decomposition by the CNN model, providing new research insights for jitter analysis in high-speed signals. Experimental results demonstrate that CNN model can effectively learn deterministic features of DCD, with 0.0174 ps mean absolute error and 0.021 ps mean square error between predicted and actual values.},
	urldate = {2026-03-26},
	booktitle = {2025 {IEEE} 17th {International} {Conference} on {Electronic} {Measurement} \& {Instruments} ({ICEMI})},
	author = {Wu, Rui and Xu, Zixuan and Sha, Yijun and Zhu, Ruiqi and Li, Rongjie and Wang, Houjun},
	month = aug,
	year = {2025},
	note = {ISSN: 2994-5100},
	keywords = {Analytical models, convolutional neural network, Convolutional neural networks, Data models, deterministic jitter, duty cycle distortion, Histograms, Jitter, jitter decomposition, Predictive models, random jitter, Signal analysis, Signal integrity, Testing, Training},
	pages = {365--370},
}

@article{hwang_power_2026,
	title = {Power {Supply} {Induced} {Jitter}: {Introduction} and {Recent} {Advances}},
	volume = {5},
	issn = {2768-1866},
	shorttitle = {Power {Supply} {Induced} {Jitter}},
	url = {https://ieeexplore.ieee.org/abstract/document/11397500},
	doi = {10.1109/TSIPI.2026.3665467},
	abstract = {Jitter is a critical concern in modern electronic systems, particularly as semiconductor devices increasingly operate with low supply rails to minimize power consumption. This article provides a comprehensive review of power supply induced jitter (PSIJ), which refers to timing variations directly caused by fluctuations in the power supply voltage. It examines the fundamental mechanisms of PSIJ and presents generalized models for predicting jitter. System-level jitter tracking characteristics are analyzed for serial links, memory interfaces, and synchronous logic to explain the resulting jitter spectrum. The article also summarizes various presilicon PSIJ modeling techniques, including time-domain, frequency-domain, slope-based, and delay-based methods. Finally, recent advancements in PSIJ research are discussed.},
	urldate = {2026-03-26},
	journal = {IEEE Transactions on Signal and Power Integrity},
	author = {Hwang, Chulsoon and Tripathi, Jai Narayan and Oh, Dan},
	year = {2026},
	keywords = {Clocks, Delays, High-speed digital system, jitter, Jitter, Noise, power distribution network (PDN), power supply, power supply induced jitter (PSIJ), Reviews, Semiconductor device modeling, Sensitivity, System-on-chip, Transfer functions, Transistors},
	pages = {22--32},
}

@inproceedings{balaji_structured_2025,
	title = {A {Structured} {Neural} {Network} {Approach} for {Learning} {Improved} {Iterative} {Algorithms} for {SBL}},
	issn = {2379-190X},
	url = {https://ieeexplore.ieee.org/abstract/document/10890518},
	doi = {10.1109/ICASSP49660.2025.10890518},
	abstract = {Sparse Bayesian Learning (SBL) is a popular sparse signal recovery method, and various algorithms exist under the SBL paradigm. In this paper, we introduce a novel re-parameterization that allows the iterations of existing algorithms to be viewed as special cases of a unified and general mapping function. Furthermore, the re-parameterization enables an interesting beamforming interpretation that lends insights to all the considered algorithms. Utilizing the abstraction allowed by the general mapping viewpoint, we introduce a novel neural network architecture for learning improved iterative update rules under the SBL framework. Our modular design of the architecture enables the model to be independent of the size of the measurement matrix and provides us a unique opportunity to test the generalization capabilities across different measurement matrices. We show that the network when trained on a particular parameterized dictionary generalizes in many ways hitherto not possible; different measurement matrices, both type and dimension, and number of snapshots. Our numerical results showcase the generalization capability of our network in terms of mean square error and probability of support recovery across sparsity levels, different signal-to-noise ratios, number of snapshots and multiple measurement matrices of different sizes.},
	urldate = {2026-03-26},
	booktitle = {{ICASSP} 2025 - 2025 {IEEE} {International} {Conference} on {Acoustics}, {Speech} and {Signal} {Processing} ({ICASSP})},
	author = {Balaji, Rushabha and Chen, Kuan-Lin and Rao, Bhaskar D.},
	month = apr,
	year = {2025},
	note = {ISSN: 2379-190X},
	keywords = {Acoustic measurements, Array signal processing, Dictionaries, Iterative methods, Neural networks, Signal processing algorithms, Signal resolution, Signal to noise ratio, Size measurement, Speech processing},
	pages = {1--5},
}

